# ==============================================================================
# 영식(Young-sik) 에이전트 환경 변수 설정
# ==============================================================================

# 1. Google Gemini API Key (기획, SEO 프롬프트, 텍스트/멀티모달 분석용)
GEMINI_API_KEY=

# 2. YouTube Data API v3 OAuth 클라이언트 시크릿 파일 경로 (기본값: client_secret.json)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# 3. 가성비 비디오 생성 엔진 API 키 (선택)
# - Fal.ai (Wan 2.1 / HunyuanVideo / LTX-Video 등 초가성비 엔진): https://fal.ai
FAL_KEY=

# - MiniMax Hailuo AI (Video-01 압도적 시네마틱 퀄리티): https://intl.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# - Kling AI (1.5 모델 커머스/모션 특화): https://klingai.com
KLING_API_KEY=
KLING_ACCESS_KEY=
